        <activity id="4e" name="Content blocks" owner="Dev Team">
          <hours manual="160" ecAemCoder="80"/>
          <deliverable>columns, quote, table, embed, download</deliverable>
        </activity>
        <activity id="4f" name="Product-specific blocks" owner="Dev Team">
          <hours manual="200" ecAemCoder="108"/>
          <deliverable>pricing-table, comparison, spec-sheet</deliverable>
        </activity>
      </activities>
    </phase>

    <phase id="4" name="Page Review &amp; Asset Migration" weeks="15-16">
