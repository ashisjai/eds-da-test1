        </activity>
        <activity id="2a" name="Extract design system tokens" owner="Dev Team">
          <hours manual="80" ecAemCoder="60"/>
          <deliverable>styles.css, CSS custom properties</deliverable>
        </activity>
        <activity id="2b" name="Typography &amp; font setup" owner="Dev Team">
          <hours manual="24" ecAemCoder="24"/>
          <deliverable>fonts.css, AT&amp;T brand fonts</deliverable>
        </activity>
        <activity id="2c" name="Core navigation blocks" owner="Dev Team">
          <hours manual="80" ecAemCoder="80"/>
          <deliverable>header/, footer/, mega-menu</deliverable>
        </activity>
      </activities>
    </phase>

    <phase id="2" name="Content Modeling" weeks="7-8">
      <hours manual="200" ecAemCoder="180"/>
