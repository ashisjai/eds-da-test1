  <phases>
    <phase id="0" name="Pre-Migration" weeks="1-2">
      <hours manual="160" ecAemCoder="160"/>
      <activities>
        <activity id="0a" name="Site audit &amp; inventory" owner="Content Strategist" hours="40">
          <deliverable>Complete page inventory, asset list</deliverable>
        </activity>
        <activity id="0b" name="Performance baseline" owner="Tech Lead" hours="24">
          <deliverable>Current Core Web Vitals report</deliverable>
        </activity>
        <activity id="0c" name="SEO audit" owner="SEO Specialist" hours="32">
          <deliverable>Rankings, meta data, structured data</deliverable>
        </activity>
        <activity id="0d" name="Stakeholder alignment &amp; kickoff" owner="PM" hours="24">
          <deliverable>RACI matrix, kickoff deck, timeline</deliverable>
        </activity>
        <activity id="0e" name="Technical discovery" owner="Tech Lead" hours="40">
          <deliverable>API inventory, integration mapping</deliverable>
        </activity>
      </activities>
    </phase>

    <phase id="1" name="Foundation" weeks="3-6">
