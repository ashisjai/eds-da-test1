      <activities>
        <activity id="5" name="Move servlets/APIs to Edge workers" owner="Dev Team" hours="160">
          <deliverable>Edge worker functions</deliverable>
        </activity>
        <activity id="5a" name="Pricing API integration" owner="Dev Team" hours="60">
          <deliverable>Dynamic pricing endpoints</deliverable>
        </activity>
        <activity id="5b" name="Lead form submission handling" owner="Dev Team" hours="40">
          <deliverable>Form backend integration</deliverable>
        </activity>
        <activity id="5c" name="Search functionality" owner="Dev Team" hours="80">
          <deliverable>Site search implementation</deliverable>
        </activity>
      </activities>
    </phase>

    <phase id="6" name="AEM Migration" weeks="19-20">
      <hours manual="280" ecAemCoder="280"/>
      <activities>
        <activity id="6" name="Migrate custom functionality to AEMaaCS" owner="Dev Team" hours="120">
          <deliverable>Reports, scheduled jobs</deliverable>
        </activity>
        <activity id="7" name="Migrate meta-schema, taxonomy, workflows" owner="Tech Lead" hours="80">
          <deliverable>AEM configurations</deliverable>
        </activity>
        <activity id="7a" name="User/group migration" owner="Admin" hours="40">
          <deliverable>Permissions in AEMaaCS</deliverable>
        </activity>
        <activity id="7b" name="Workflow configuration" owner="Tech Lead" hours="40">
          <deliverable>Approval workflows</deliverable>
        </activity>
      </activities>
    </phase>

    <phase id="7" name="Integrations" weeks="21-22">
      <hours manual="160" ecAemCoder="160"/>
      <activities>
        <activity id="8a" name="Analytics/tracking setup" owner="Dev Team" hours="60">
          <deliverable>Adobe Launch configuration</deliverable>
        </activity>
        <activity id="8b" name="Third-party scripts" owner="Dev Team" hours="40">
          <deliverable>Chat, pixels, consent banner</deliverable>
        </activity>
        <activity id="8c" name="Search indexing configuration" owner="Dev Team" hours="40">
          <deliverable>Sitemap, robots.txt</deliverable>
        </activity>
        <activity id="8d" name="Social meta tags" owner="Dev Team" hours="20">
          <deliverable>OG tags, Twitter cards</deliverable>
        </activity>
      </activities>
    </phase>

    <phase id="8" name="Validation &amp; Testing" weeks="23-24">
      <hours manual="380" ecAemCoder="340"/>
      <activities>
        <activity id="8" name="Validate all functionalities" owner="QA Team" hours="160">
          <deliverable>Functional test reports</deliverable>
        </activity>
        <activity id="9" name="Accessibility audit (WCAG 2.1 AA)" owner="QA Team" hours="80">
          <deliverable>Accessibility report, fixes</deliverable>
        </activity>
        <activity id="10" name="Performance/load testing" owner="QA Team" hours="60">
          <deliverable>Performance test results</deliverable>
        </activity>
        <activity id="11" name="SEO validation" owner="SEO Specialist" hours="40">
          <deliverable>Redirect testing, sitemap validation</deliverable>
        </activity>
        <activity id="12" name="Security review" owner="Security Team" hours="40">
          <deliverable>Security headers, CSP audit</deliverable>
        </activity>
      </activities>
    </phase>

    <phase id="9" name="Launch" weeks="24+">
      <hours manual="260" ecAemCoder="260"/>
      <activities>
        <activity id="13" name="UAT &amp; stakeholder sign-off" owner="PM" hours="80">
          <deliverable>Sign-off documentation</deliverable>
        </activity>
        <activity id="14" name="DNS cutover &amp; rollback plan" owner="Tech Lead" hours="40">
          <deliverable>Production deployment</deliverable>
        </activity>
        <activity id="15" name="Author training on Universal Editor" owner="Training Lead" hours="60">
          <deliverable>Training materials, sessions</deliverable>
        </activity>
        <activity id="16" name="Hypercare &amp; monitoring setup" owner="DevOps" hours="80">
          <deliverable>Monitoring dashboards, alerts</deliverable>
        </activity>
      </activities>
    </phase>
