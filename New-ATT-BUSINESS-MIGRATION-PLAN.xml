          <deliverable>CF models for products, stories</deliverable>
        </activity>
        <activity id="3c" name="Update transformations" owner="Dev Team" hours="40">
          <deliverable>Import script transformations</deliverable>
        </activity>
      </activities>
    </phase>

    <phase id="3" name="Block Development" weeks="9-14">
      <hours manual="1080" ecAemCoder="600"/>
      <activities>
        <activity id="4a" name="Hero blocks (6 variants)" owner="Dev Team">
          <hours manual="120" ecAemCoder="72"/>
          <deliverable>hero-video, hero-carousel, hero-split, etc.</deliverable>
        </activity>
        <activity id="4b" name="Card blocks (10 variants)" owner="Dev Team">
          <hours manual="200" ecAemCoder="100"/>
          <deliverable>cards-product, cards-feature, cards-pricing, etc.</deliverable>
        </activity>
        <activity id="4c" name="Interactive blocks" owner="Dev Team">
